# Erlaubt ausschließlich die Verwaltung des Home-Assistant-Tunneldienstes und WireGuard aus der WebGUI.
Cmnd_Alias POWERGATEWAY_TUNNELS = /usr/bin/systemctl start powergateway-ha-tunnel.service, /usr/bin/systemctl stop powergateway-ha-tunnel.service, /usr/bin/systemctl restart powergateway-ha-tunnel.service, /usr/bin/systemctl enable powergateway-ha-tunnel.service, /usr/bin/systemctl disable powergateway-ha-tunnel.service, /usr/bin/systemctl enable --now powergateway-ha-tunnel.service, /usr/bin/systemctl disable --now powergateway-ha-tunnel.service, /usr/bin/systemctl restart wg-quick@wg0.service
powergateway ALL=(root) NOPASSWD: POWERGATEWAY_TUNNELS
