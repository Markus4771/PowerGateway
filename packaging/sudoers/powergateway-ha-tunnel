# Erlaubt ausschließlich die Verwaltung des PowerGateway-SSH-Tunneldienstes aus der WebGUI.
Cmnd_Alias POWERGATEWAY_HA_TUNNEL = /usr/bin/systemctl start powergateway-ha-tunnel.service, /usr/bin/systemctl stop powergateway-ha-tunnel.service, /usr/bin/systemctl restart powergateway-ha-tunnel.service, /usr/bin/systemctl enable powergateway-ha-tunnel.service, /usr/bin/systemctl disable powergateway-ha-tunnel.service, /usr/bin/systemctl enable --now powergateway-ha-tunnel.service, /usr/bin/systemctl disable --now powergateway-ha-tunnel.service
powergateway ALL=(root) NOPASSWD: POWERGATEWAY_HA_TUNNEL
