[Unit]
Description=PowerGateway LTE-Modem Reverse Proxy
After=network-online.target powergateway-network.service powergateway-lte-proxy-address.service
Wants=network-online.target
Requires=powergateway-network.service powergateway-lte-proxy-address.service

[Service]
Type=simple
User=powergateway
Group=powergateway
WorkingDirectory=/opt/powergateway/src
Environment=PYTHONUNBUFFERED=1
Environment=POWERGATEWAY_LTE_PROXY_TARGET=http://192.168.0.1/
Environment=POWERGATEWAY_LTE_PROXY_PUBLIC_ORIGIN=http://192.168.50.254
ExecStart=/bin/sh -c 'if [ -x /opt/powergateway/venv/bin/gunicorn ]; then exec /opt/powergateway/venv/bin/gunicorn --workers 2 --threads 2 --bind 192.168.50.254:80 --access-logfile - --error-logfile - lte_modem_proxy:app; else exec /usr/bin/gunicorn --workers 2 --threads 2 --bind 192.168.50.254:80 --access-logfile - --error-logfile - lte_modem_proxy:app; fi'
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/powergateway /opt/powergateway
ReadWritePaths=/var/lib/powergateway

[Install]
WantedBy=multi-user.target
