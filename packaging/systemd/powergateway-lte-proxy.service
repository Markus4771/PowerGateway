[Unit]
Description=PowerGateway LTE-Modem Reverse Proxy
After=network-online.target powergateway-network.service
Wants=network-online.target
Requires=powergateway-network.service

[Service]
Type=simple
User=powergateway
Group=powergateway
WorkingDirectory=/opt/powergateway/src
Environment=PYTHONUNBUFFERED=1
Environment=POWERGATEWAY_LTE_PROXY_TARGET=http://192.168.0.1/
Environment=POWERGATEWAY_LTE_PROXY_PUBLIC_ORIGIN=http://192.168.50.254
ExecStart=/bin/sh -c 'if [ -x /opt/powergateway/venv/bin/gunicorn ]; then exec /opt/powergateway/venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:8081 --access-logfile - --error-logfile - lte_modem_proxy:app; else exec /usr/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:8081 --access-logfile - --error-logfile - lte_modem_proxy:app; fi'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/powergateway /opt/powergateway
ReadWritePaths=/var/lib/powergateway

[Install]
WantedBy=multi-user.target
